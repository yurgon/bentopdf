{
  "manifest_version": 3,
  "name": "Plyleaf: Save Web Page as PDF",
  "short_name": "Plyleaf",
  "version": "1.0.0",
  "description": "Save any web page as a PDF in one click and open PDFs in free Plyleaf tools. No account, no uploads: files stay on your device.",
  "homepage_url": "https://plyleaf.com/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save this page as PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "optional_permissions": ["debugger"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://plyleaf.com/*"],
      "js": ["receive.js"],
      "run_at": "document_idle"
    }
  ]
}
