{
  "manifest_version": 3,
  "name": "Plyleaf: ChatGPT to PDF, Claude and Gemini Export",
  "short_name": "Plyleaf Chat",
  "version": "1.0.0",
  "description": "Save ChatGPT, Claude, Gemini, Perplexity and DeepSeek chats as PDF, Markdown or Word. Code and math stay sharp. Nothing is uploaded.",
  "homepage_url": "https://plyleaf.com/",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Export this chat to PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_permissions": ["debugger"],
  "commands": {
    "export-pdf": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Export the open chat to PDF"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
